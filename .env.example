# ── AI Integration ────────────────────────────────────────────────
# Claude API key — leave blank to disable AI-assisted checks
ANTHROPIC_API_KEY=

# AI model selection (default: claude-sonnet-4-6)
# Change if that model is unavailable; do not hardcode in source
CUBE_AI_MODEL=claude-sonnet-4-6

# ── RM Integration ─────────────────────────────────────────────────
# Base URL for the RM API (example only — configure per your environment)
RM_BASE_URL=https://rm.gocube.global
# Bearer token or API key for read-only RM access
RM_API_TOKEN=
# HTTP timeout for RM requests (seconds)
RM_TIMEOUT=15

# ── HTTP Retrieval ─────────────────────────────────────────────────
# Maximum seconds to wait for source URL retrieval
SOURCE_FETCH_TIMEOUT=20
# Maximum file size to download (bytes). Default: 50 MB
SOURCE_MAX_BYTES=52428800
# Comma-separated hosts that are explicitly allowed for internal lookups
ALLOWED_INTERNAL_HOSTS=rm.gocube.global

# ── OCR ────────────────────────────────────────────────────────────
# Path to Tesseract executable (leave blank to use PATH default)
TESSERACT_CMD=

# ── Feature Flags ──────────────────────────────────────────────────
# Set to "1" to enable Playwright rendering for JS-heavy sources
ENABLE_PLAYWRIGHT=0
# Set to "1" to send source content to the AI for analysis
AI_SOURCE_ANALYSIS=1
